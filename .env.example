# Compose configuration. Copy to .env and replace the placeholders.
# PostgreSQL remains external; on Docker Desktop, host.docker.internal reaches
# a database running on the host. Use another reachable host as appropriate.
DATABASE_URL=postgresql+asyncpg://user:password@host.docker.internal:5432/shopsmart_ai
SECRET_KEY=replace-with-a-random-secret-before-use

# Payment checkout is disabled until Stripe test/sandbox credentials are set.
# Never use live Stripe credentials for local or QA runs.
PAYMENT_PROVIDER=stripe
PAYMENT_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=http://localhost:3000/checkout/complete
PAYMENT_CANCEL_URL=http://localhost:3000/checkout/complete?payment=cancelled

# AI provider keys stay server-side. deterministic is the safe local default.
AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
AI_MODEL_ROUTING_MODE=ADAPTIVE_FREE
AI_FIXED_MODEL=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_EXTERNAL_PRIVATE_DATA_ENABLED=false
# Comma-separated server knowledge source keys approved for external LLM use.
AI_EXTERNAL_PUBLIC_KNOWLEDGE_SOURCE_KEYS=
AI_MODEL_PRICING_JSON=

# Console discards messages. For inbox delivery, use Resend with a verified
# domain or SMTP with a mailbox app password.
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=ShopSmart AI <orders@example.test>
EMAIL_WORKER_ENABLED=false
PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
EMAIL_REQUEUE_REQUEST_ID=
APP_ENV=local
EMAIL_WORKER_POLL_SECONDS=5

# Compose service DNS is used for backend-to-Redis traffic.
REDIS_URL=redis://redis:6379/0
# Optional. Set a unique random URL-safe value of at least 32 characters to
# enable the protected metrics endpoint; leave blank to keep it disabled.
OBSERVABILITY_METRICS_TOKEN=
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Inlined into the browser bundle at frontend build time; this must be a
# browser-reachable URL, not the Compose-only backend service name.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
