# Frontend Environment Configuration
# Copy this to .env.local and configure for your environment

# Auth BFF backend URL (server-only; never expose with NEXT_PUBLIC_)
API_INTERNAL_URL=http://localhost:8000/api/v1

# Kept for local integrations that explicitly need the public API origin; browser auth and commerce
# requests use same-origin /api/auth/* and /api/* routes instead.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=ShopSmart AI

# Debug
NEXT_PUBLIC_DEBUG=false
