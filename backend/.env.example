# ShopSmart AI Backend Configuration
# Copy this to .env and configure for your environment

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/shopsmart_ai
DATABASE_ECHO=False
# Defaults to True for the existing local development behavior. Docker Compose
# sets this to False so schema changes are applied explicitly through Alembic.
AUTO_CREATE_TABLES=True

# Security
# Generate a unique non-empty secret before starting the backend.
SECRET_KEY=
ALGORITHM=HS256

# Session
SESSION_TIMEOUT_SECONDS=2592000  # 30 days in seconds

# Payment provider. Stripe is sandbox/test only; checkout is unavailable until
# all three Stripe test values are configured. Never put live keys here.
PAYMENT_PROVIDER=stripe
PAYMENT_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=http://localhost:3000/checkout/complete
PAYMENT_CANCEL_URL=http://localhost:3000/checkout/complete?payment=cancelled

# Transactional email. `console` discards messages. Choose Resend with a
# verified domain or SMTP with a mailbox app password to deliver to inboxes.
EMAIL_PROVIDER=console  # console | resend | smtp
EMAIL_FROM_ADDRESS=ShopSmart AI <orders@example.test>
EMAIL_WORKER_ENABLED=False  # local API-hosted worker only; Compose uses the email profile
PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=False
EMAIL_REQUEUE_REQUEST_ID=

# Redis (optional, for rate limiting and caching)
REDIS_URL=redis://localhost:6379/0
PRODUCT_CATALOG_CACHE_TTL_SECONDS=60

# API
API_PREFIX=/api/v1
APP_ENV=local
DEBUG=False
LOG_LEVEL=INFO
# Optional. A unique random URL-safe value of at least 32 characters enables
# GET /api/v1/observability/metrics with a Bearer token. Leave blank to disable.
OBSERVABILITY_METRICS_TOKEN=

# Governed AI provider gateway. Keep all provider keys server-side.
AI_PROVIDER=deterministic
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Customer-owned AI document ingestion is disabled for the commerce assistant.
# It requires AI_USER_DOCUMENTS_ENABLED=True and APP_ENV=local/dev/development/test.
AI_USER_DOCUMENTS_ENABLED=False

# Curated, server-side knowledge publication requires both --apply and this opt-in.
SHOPSMART_ALLOW_KNOWLEDGE_PUBLISH=false

# CORS
# Pydantic settings expects a JSON array. Add the exact deployed frontend
# origin(s) in the deployment environment; do not use '*'.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
