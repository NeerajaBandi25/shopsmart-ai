# ShopSmart AI Backend Configuration
# Copy this to .env and configure for your environment

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/shopsmart_ai
DATABASE_ECHO=False
# Defaults to True for the existing local development behavior. Docker Compose
# sets this to False so schema changes are applied explicitly through Alembic.
AUTO_CREATE_TABLES=True

# Security
# Generate a unique non-empty secret before starting the backend.
SECRET_KEY=
ALGORITHM=HS256

# Session
SESSION_TIMEOUT_SECONDS=2592000  # 30 days in seconds

# Email Provider
EMAIL_PROVIDER=mock  # Options: mock, prod
EMAIL_FROM=noreply@shopsmart-ai.local

# Redis (optional, for rate limiting and caching)
REDIS_URL=redis://localhost:6379/0
PRODUCT_CATALOG_CACHE_TTL_SECONDS=60

# API
API_PREFIX=/api/v1
DEBUG=False
LOG_LEVEL=INFO
# Optional. A unique random URL-safe value of at least 32 characters enables
# GET /api/v1/observability/metrics with a Bearer token. Leave blank to disable.
OBSERVABILITY_METRICS_TOKEN=

# Governed AI provider gateway. Keep all provider keys server-side.
AI_PROVIDER=deterministic
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS
# Pydantic settings expects a JSON array. Add the exact deployed frontend
# origin(s) in the deployment environment; do not use '*'.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
